# --- INVOXIS AI frontend configuration (copy to .env.local; Vite only exposes VITE_* variables) --------
# NEVER put the Groq API key here: anything prefixed VITE_ is embedded in the browser bundle.
# The key belongs in backend/.env (see backend/.env.example).

# demo    = localStorage + mock data (default; no backend required)
# backend = FastAPI persistence + Groq extraction (no silent fallback to demo data)
VITE_APP_MODE=demo

# Only used when VITE_APP_MODE=backend
VITE_API_BASE_URL=http://localhost:8000/api/v1
