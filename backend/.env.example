# --- INVOXIS AI backend configuration (copy to backend/.env; never commit the real file) -------------
APP_ENV=development
LOG_LEVEL=INFO

# Groq (server-side only; never exposed to the browser). GROQ_API_KEY and GROQ_MODEL are required for extraction.
# Model ids change: pick one from https://console.groq.com/docs/models. No default is hardcoded.
#  - GROQ_MODEL        : used for PDFs that have a text layer. It must support JSON output
#                        (see GROQ_STRUCTURED_MODE below).
#  - GROQ_VISION_MODEL : used for scanned/image-only PDFs. Must accept images (e.g. a Llama 4 vision model).
#                        Leave empty to use GROQ_MODEL for scans too (fails with a clear error if it can't).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_OUTPUT_TOKENS=8192
# json_schema = send the schema as response_format (only some models support it)
# json_object = plain JSON mode with the schema in the prompt (works on more models)
GROQ_STRUCTURED_MODE=json_object
# Scanned PDFs: Groq limits images per request (varies by model, commonly 5) and ~4 MB total for inline base64.
GROQ_MAX_IMAGES=5
MAX_IMAGE_PAYLOAD_MB=3.0
# Text PDFs: prompt budget in characters (longer text is truncated and flagged)
MAX_PROMPT_CHARS=60000

DATABASE_URL=sqlite:///./data/invoxis.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=30

# Explicit origins only (comma separated). Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000

# Default rounding tolerance in invoice currency units
ROUNDING_TOLERANCE=0.02

# thread = background worker pool (default); inline = synchronous (used by tests)
JOB_EXECUTION_MODE=thread
